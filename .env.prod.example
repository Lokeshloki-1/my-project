# Copy to .env.prod on the server and fill in. NEVER commit .env.prod.

# Your domain, pointed at the server's IP (DNS "A" record). Caddy gets the HTTPS certificate automatically.
SITE_ADDRESS=erp.example.com
DJANGO_ALLOWED_HOSTS=erp.example.com
CSRF_TRUSTED_ORIGINS=https://erp.example.com
CORS_ALLOWED_ORIGINS=https://erp.example.com

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Database. Use a long random password.
POSTGRES_DB=hazpo
POSTGRES_USER=hazpo
POSTGRES_PASSWORD=

# Gunicorn worker processes (about 2 x CPU cores + 1)
WEB_CONCURRENCY=3
# After HTTPS works for a few days, set to 31536000.
DJANGO_HSTS_SECONDS=0

# Razorpay — LIVE keys in production (rzp_live_...). Leave empty to hide UPI QR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_QR_MINUTES=15
